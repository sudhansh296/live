# Copy to .env and fill in. .env is git-ignored; never commit real values.
NODE_ENV=development

# 127.0.0.1 = this PC only (emulator reaches it via 10.0.2.2). Use 0.0.0.0 only to test on a real phone over Wi-Fi.
HOST=127.0.0.1
PORT=4000

# Number of reverse proxies in front of the app (0 = none, 1 = nginx). Needed for correct client IPs.
TRUST_PROXY=0

# Comma separated web origins allowed by CORS (admin panel). Empty = no CORS headers.
CORS_ORIGINS=

# MariaDB / MySQL (XAMPP for local development)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Signs access tokens. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Optional overrides (defaults shown)
# JWT_ISSUER=hivo-live
# JWT_AUDIENCE=hivo-app
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=30
# REFRESH_REUSE_GRACE_SECONDS=10
# AUTH_MAX_AGE_SECONDS=300

# Firebase service-account key. If empty, the first *.json in server/secrets/ is used.
# FIREBASE_SERVICE_ACCOUNT_PATH=
